# example.envrc — TEMPLATE. Copy to .envrc, uncomment, and fill in the values
# this repo's tasks actually need. Commit example.envrc; keep .envrc out of git.
#
# This file documents the environment a repo expects. Tasks guard these with
# `requires:` (fail fast if unset) or read them via env-overridable vars, e.g.
# VAULT_ADDR: '{{.VAULT_ADDR | default "https://vault.example:8200"}}'.
#
# With direnv:   direnv allow
# Without it:    set -a; . ./.envrc; set +a   (the `export` lines only)
#
# Any Task variable can be set by an env var of the SAME name; a CLI arg
# (task <t> VAR=value) still overrides it. So .envrc is how you drive/pin Task
# vars durably without retyping CLI flags.

# --- Pin/track a methridge/taskfiles version (for `task sync`) ---
# A bare `task sync` stays on the version this repo shipped with. To track a
# different (usually newer) version durably, pin it here — .envrc is not synced.
# Must be a concrete tag; `sync` does not resolve "latest" (init.sh does).
# export TASKFILES_REF="v1.0.0"

# --- .taskfiles/config vs .envrc ---
# TASKFILES_FILES (which shared files sync pulls, e.g. add go.yml/ansible.yml)
# and TASKFILES_CLAUDE_PROFILE (which claude/<name>.json profile sync writes to
# .claude/settings.json) are repo data, not per-checkout secrets - commit them
# in the repo's own .taskfiles/config instead of here (init.sh writes that file
# for you at bootstrap; see STANDARD.md / README.md). Resolution order for both,
# high to low: a CLI arg (task sync VAR=value) > the committed
# .taskfiles/config value > an ambient env var (e.g. the exports below) > the
# taskfile default. A committed .taskfiles/config value deliberately is NOT
# overridden by an export here - only uncomment these to override the
# committed config for a one-off in this checkout.
# Valid TASKFILES_CLAUDE_PROFILE values: terraform, terraform-provider, packer, claude-config
# export TASKFILES_FILES="git.yml scripts/lib.sh scripts/merge.sh scripts/push.sh scripts/review.sh"
# export TASKFILES_CLAUDE_PROFILE="terraform"

# PRECOMMIT is recorded in .taskfiles/config by init.sh (which precommit/
# template seeded .pre-commit-config.yaml) but `sync` never reads or acts on
# it - .pre-commit-config.yaml is repo-owned and hand-tunable. Not an .envrc
# variable; listed here only so its absence from this template isn't a gap.

# --- Required by this repo's tasks (examples — replace with the real set) ---
# export VAULT_ADDR="https://vault.example:8200"
# export VAULT_NAMESPACE="admin/example"
# export OCP_NAMESPACE="my-namespace"
# export OCP_SERVER="https://api.cluster.example:6443"
# export AAP_HOST="https://aap.example"

# --- Credentials for a profile's MCP server (see STANDARD.md) ---
# A synced ./.mcp.json is committed and shared, so it holds no secrets - it
# only references them, e.g. "TFE_TOKEN": "${TFE_TOKEN}". Claude Code expands
# those from the environment this .envrc sets up, so the value stays here, in
# the gitignored file, and never lands in a tracked one.
#
# The `terraform` profile's .mcp.json expects these two. Without them the
# server still starts, but only registers the public registry/docs tools -
# workspaces, runs, and private modules silently go missing.
# TFE_ADDRESS must match the `hostname` in the repo's `cloud {}` block -
# app.terraform.io for HCP Terraform, or your own host for a self-hosted TFE.
# A token is issued by one instance and rejected by the other, so a mismatched
# pair fails as a 401 that looks like a bad token rather than a wrong address.
# export TFE_ADDRESS="https://app.terraform.io/"
# export TFE_ADDRESS="https://tfe.example.internal"
#
# Pick whichever secret store the repo already uses. A command substitution
# keeps the token out of this file, so rotating it upstream needs no edit here:
# export TFE_TOKEN="$(op read --cache 'op://<vault>/<item>/<field>')"
# export TFE_TOKEN="$(vault kv get -field=token secrets/tfe)"
#
# Sanity check after editing - 200 = good, 401 = wrong token OR wrong host:
#   curl -s -o /dev/null -w '%{http_code}\n' \
#     -H "Authorization: Bearer $TFE_TOKEN" \
#     "$TFE_ADDRESS/api/v2/account/details"

# --- Optional direnv stdlib integrations (only run under `direnv`) ---
# use vault           # populate secrets via direnv's vault integration
# dotenv_if_exists    # layer in a local .env if one is present
